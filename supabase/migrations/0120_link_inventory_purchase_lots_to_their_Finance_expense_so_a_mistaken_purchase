-- FarmOS migration 0120
-- Link inventory purchase lots to their Finance expense so a mistaken purchase
-- can be removed atomically without guessing which expense belongs to it.

alter table public.finance_transactions
  add column if not exists inventory_lot_id uuid
  references public.inventory_lots(id) on delete restrict;

create unique index if not exists finance_transactions_inventory_lot_id_uidx
  on public.finance_transactions(inventory_lot_id)
  where inventory_lot_id is not null;

comment on column public.finance_transactions.inventory_lot_id is
  'Inventory purchase lot that generated this expense; enables safe paired deletion.';

-- Safely link legacy purchases only where the match is unique in both
-- directions (same item category, date, and exact amount). Ambiguous history
-- remains unlinked and cannot be deleted automatically.
with candidates as (
  select
    l.id as lot_id,
    ft.id as transaction_id,
    count(*) over (partition by l.id) as lot_match_count,
    count(*) over (partition by ft.id) as transaction_match_count
  from public.inventory_lots l
  join public.inventory_items i on i.id = l.item_id
  join public.finance_transactions ft
    on ft.type = 'expense'
   and ft.category = i.name
   and ft.occurred_at::date = l.purchased_at
   and ft.amount = (l.qty_purchased * l.cost_per_unit)
   and ft.inventory_lot_id is null
   and ft.sale_id is null
   and ft.project_id is null
   and ft.entity_id is null
)
update public.finance_transactions ft
set inventory_lot_id = c.lot_id
from candidates c
where ft.id = c.transaction_id
  and c.lot_match_count = 1
  and c.transaction_match_count = 1;

-- Record future purchases with an explicit one-to-one link to the Finance row.
create or replace function public.record_inventory_purchase(
  p_item_id uuid,
  p_qty numeric,
  p_cost_per_unit numeric,
  p_purchased_at date default current_date
)
returns void
language plpgsql
security definer
set search_path = public
as $function$
declare
  v_item_name text;
  v_lot_id uuid;
begin
  if not public.farm_can_write() then
    raise exception 'Write access denied';
  end if;

  if p_item_id is null then
    raise exception 'Inventory item is required';
  end if;

  if p_qty is null or p_qty <= 0 then
    raise exception 'Quantity must be positive';
  end if;

  if p_cost_per_unit is null or p_cost_per_unit < 0 then
    raise exception 'Cost per unit cannot be negative';
  end if;

  select name
    into v_item_name
  from public.inventory_items
  where id = p_item_id;

  if v_item_name is null then
    raise exception 'Inventory item not found';
  end if;

  insert into public.inventory_lots (
    item_id,
    qty_purchased,
    qty_remaining,
    cost_per_unit,
    purchased_at
  ) values (
    p_item_id,
    p_qty,
    p_qty,
    p_cost_per_unit,
    coalesce(p_purchased_at, current_date)
  )
  returning id into v_lot_id;

  insert into public.finance_transactions (
    type,
    amount,
    category,
    occurred_at,
    inventory_lot_id
  ) values (
    'expense',
    p_qty * p_cost_per_unit,
    v_item_name,
    coalesce(p_purchased_at, current_date),
    v_lot_id
  );
end;
$function$;

revoke all on function public.record_inventory_purchase(uuid, numeric, numeric, date) from public;
grant execute on function public.record_inventory_purchase(uuid, numeric, numeric, date) to authenticated;

-- Delete the linked Finance expense and lot in one database transaction.
-- Any consumption or reconciliation reference blocks deletion; this includes
-- reversed event consumption rows to preserve the full audit trail.
create or replace function public.delete_inventory_purchase(p_lot_id uuid)
returns jsonb
language plpgsql
security definer
set search_path = public
as $function$
declare
  v_lot public.inventory_lots%rowtype;
  v_item_name text;
  v_transaction_id uuid;
begin
  if not public.farm_can_write() then
    raise exception 'Write access denied';
  end if;

  if p_lot_id is null then
    raise exception 'Purchase lot is required';
  end if;

  select *
    into v_lot
  from public.inventory_lots
  where id = p_lot_id
  for update;

  if not found then
    raise exception 'Inventory purchase lot not found';
  end if;

  select name into v_item_name
  from public.inventory_items
  where id = v_lot.item_id;

  if exists (
    select 1 from public.inventory_consumptions
    where lot_id = p_lot_id
  ) then
    raise exception 'Cannot delete this purchase: it has consumption history. Preserve the audit trail and correct the related Daily Log instead.';
  end if;

  if exists (
    select 1 from public.inventory_lot_reconciliations
    where lot_id = p_lot_id
  ) or exists (
    select 1 from public.inventory_consumption_reconciliations
    where lot_id = p_lot_id
  ) then
    raise exception 'Cannot delete this purchase: it has reconciliation history.';
  end if;

  select id
    into v_transaction_id
  from public.finance_transactions
  where inventory_lot_id = p_lot_id
    and type = 'expense'
  for update;

  if v_transaction_id is null then
    raise exception 'This historical purchase has no safely linked Finance expense. It was not deleted. Link or reconcile the legacy Finance record first; FarmOS will not guess which expense to remove.';
  end if;

  if (select count(*) from public.finance_transactions where inventory_lot_id = p_lot_id) <> 1 then
    raise exception 'Cannot delete this purchase: the Finance link is not one-to-one.';
  end if;

  delete from public.finance_transactions
  where id = v_transaction_id
    and inventory_lot_id = p_lot_id
    and type = 'expense';

  if not found then
    raise exception 'The linked Finance expense could not be deleted.';
  end if;

  delete from public.inventory_lots where id = p_lot_id;
  if not found then
    raise exception 'The inventory lot could not be deleted.';
  end if;

  return jsonb_build_object(
    'lot_id', p_lot_id,
    'finance_transaction_id', v_transaction_id,
    'item_name', v_item_name,
    'purchase_date', v_lot.purchased_at,
    'amount', v_lot.qty_purchased * v_lot.cost_per_unit
  );
end;
$function$;

revoke all on function public.delete_inventory_purchase(uuid) from public;
grant execute on function public.delete_inventory_purchase(uuid) to authenticated;
